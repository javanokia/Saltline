{
  "name": "jm-3a-game",
  "version": "1.0.0",
  "private": true,
  "description": "几猫国产3A大作 - Fable 5.2 自主研发国产FPS第一人称射击游戏（逆向还原工程）",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "workshop": "vite --host --open /asset-preview/index.html",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node tests/run_e2e_test.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.187.0",
    "acorn": "^8.19.0",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
